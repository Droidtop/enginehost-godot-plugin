{
  "bundleId": "dev.enginehost.godot.v41.v1",
  "engine": "godot",
  "pluginVersion": "0.1",
  "apiVersion": 1,
  "entrypoint": "dev.enginehost.plugin.godot.GodotEnginePlugin",
  "origin": "https://github.com/droidtop/enginehost-godot-plugin",
  "dexFiles": [
    "runtime/godot.apk"
  ],
  "resourceApks": [
    "runtime/godot.apk"
  ],
  "capabilities": [
    {
      "id": "godot-4.1-standard-v1",
      "engineContext": "standard",
      "runtimeVersion": "4.1.4",
      "supportedSeries": [
        "4.1"
      ],
      "runtimeComponents": {}
    }
  ],
  "declaredOptions": [
    {
      "key": "platform",
      "label": "Platform the game sees",
      "type": "choice",
      "description": "What the engine tells the game it is running on. A game exported for a desktop behaves as it does there when it sees that desktop; some games switch to a touch layout of their own when they see Android.",
      "choices": [
        {
          "value": "export",
          "label": "The platform it was exported for (default)"
        },
        {
          "value": "android",
          "label": "Android"
        }
      ]
    }
  ],
  "source": {
    "upstream": "https://github.com/godotengine/godot",
    "revision": "4.1.4-stable"
  },
