+			final java.util.concurrent.atomic.AtomicBoolean finished = new java.util.concurrent.atomic.AtomicBoolean();
+			final Runnable once = () -> {
+				if (finished.compareAndSet(false, true) && finishDrawing != null) {
+					finishDrawing.run();
+				}
+			};
+			mGLThread.requestRenderAndNotify(once);
+			postDelayed(once, FINISH_DRAWING_WAIT_MS);
 		}
 	}
 
+	/** How long the window waits for the GL thread's first frame before it draws without it. */
