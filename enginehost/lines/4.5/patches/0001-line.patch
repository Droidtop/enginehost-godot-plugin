+		if (p_feature == "pc") {
+			return true;
+		}
+		if (p_feature == "mobile") {
+			return false;
+		}
+		if (presented == "Windows" && p_feature == "windows") {
+			return true;
+		}
+		if (presented == "Linux" && (p_feature == "linux" || p_feature == "linuxbsd")) {
+			return true;
+		}
+		if (presented == "macOS" && p_feature == "macos") {
+			return true;
+		}
+	}
+
